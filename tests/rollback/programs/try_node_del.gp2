// Same as if_node_del but with a try statement: the condition deletes a
// node (empty-RHS rule) and then fails, so the deletion is rolled back and
// the resurrected node must be matchable by the else-branch.
Main = try (del; never) then yes else no

del()
[ (n0, 1) | ]
=>
[ | ]
interface = { }

never()
[ (n0, 42) | ]
=>
[ (n0, 42) | ]
interface = {n0}

yes()
[ (n0, 0) | ]
=>
[ (n0, 100) | ]
interface = {n0}

no()
[ (n0, 1) | ]
=>
[ (n0, 99) | ]
interface = {n0}
